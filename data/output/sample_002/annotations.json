  "utterances": [
    {
      "speaker_id": "speaker_1",
      "speaker_name": "Speaker 1",
      "gender": "female",
      "language": "fr",
      "vocal_style": "normal",
      "start_time_s": 0.89,
      "end_time_s": 5.0,
      "duration_s": 4.11,
      "text": "Il est trois heures du matin. Le monde semble tenir son souffle, non ?",
      "speaker_position": [
        3.01,
        2.77,
        1.78
      ],
      "speaker_size": 0.19
    },
    {
      "speaker_id": "speaker_2",
      "speaker_name": "Speaker 2",
      "gender": "male",
      "language": "fr",
      "vocal_style": "normal",
      "start_time_s": 5.23,
      "end_time_s": 9.83,
      "duration_s": 4.6,
      "text": "Absolument. C'est l'heure où les pensées prennent plus de poids que les mots.",
      "speaker_position": [
        2.84,
        5.05,
        1.27
      ],
      "speaker_size": 0.17
    },
    {
      "speaker_id": "speaker_1",
      "speaker_name": "Speaker 1",
      "gender": "female",
      "language": "fr",
      "vocal_style": "normal",
      "start_time_s": 10.14,
      "end_time_s": 14.75,
      "duration_s": 4.61,
      "text": "Je me demande si nous sommes vraiment des êtres uniques, ou juste des agrégats d'atomes errants.",
      "speaker_position": [
        3.01,
        2.77,
        1.78
      ],
      "speaker_size": 0.19
    },
    {
      "speaker_id": "speaker_2",
      "speaker_name": "Speaker 2",
      "gender": "male",
      "language": "fr",
      "vocal_style": "normal",
      "start_time_s": 14.95,
      "end_time_s": 20.52,
      "duration_s": 5.57,
      "text": "Une belle image. Mais si nous sommes des agrégats, pourquoi cette conscience de flotter ?",
      "speaker_position": [
        2.84,
        5.05,
        1.27
      ],
      "speaker_size": 0.17
    },
    {
      "speaker_id": "speaker_1",
      "speaker_name": "Speaker 1",
      "gender": "female",
      "language": "fr",
      "vocal_style": "normal",
      "start_time_s": 20.79,
      "end_time_s": 24.83,
      "duration_s": 4.04,
      "text": "Peut-être parce que nous cherchons une ancre. Comme une boussole sans aiguille.",
      "speaker_position": [
        3.01,
        2.77,
        1.78
      ],
      "speaker_size": 0.19
    },
    {
      "speaker_id": "speaker_2",
      "speaker_name": "Speaker 2",
      "gender": "male",
      "language": "fr",
      "vocal_style": "normal",
      "start_time_s": 25.25,
      "end_time_s": 31.79,
      "duration_s": 6.54,
      "text": "Ou peut-être que nous sommes simplement... aflagellar. Sans ces petits filaments qui nous propulsent vers un but précis.",
      "speaker_position": [
        2.84,
        5.05,
        1.27
      ],
      "speaker_size": 0.17
    },
    {
      "speaker_id": "speaker_1",
      "speaker_name": "Speaker 1",
      "gender": "female",
      "language": "fr",
      "vocal_style": "normal",
      "start_time_s": 32.08,
      "end_time_s": 38.04,
      "duration_s": 5.96,
      "text": "Aflagellar... Je n'avais jamais utilisé ce mot avant. Mais ça résonne. On dérive plutôt qu'on nage.",
      "speaker_position": [
        3.01,
        2.77,
        1.78
      ],
      "speaker_size": 0.19
    },
    {
      "speaker_id": "speaker_2",
      "speaker_name": "Speaker 2",
      "gender": "male",
      "language": "fr",
      "vocal_style": "normal",
      "start_time_s": 38.41,
      "end_time_s": 44.77,
      "duration_s": 6.36,
      "text": "Exactement. Et pourtant, nous avons cette éphorée intérieure, ce gardien du temps qui nous observe.",
      "speaker_position": [
        2.84,
        5.05,
        1.27
      ],
      "speaker_size": 0.17
    },
    {
      "speaker_id": "speaker_1",
      "speaker_name": "Speaker 1",
      "gender": "female",
      "language": "fr",
      "vocal_style": "normal",
      "start_time_s": 45.1,
      "end_time_s": 48.0,
      "duration_s": 2.9,
      "text": "L'éphorée... Comme un juge silencieux dans notre crâne.",
      "speaker_position": [
        3.01,
        2.77,
        1.78
      ],
      "speaker_size": 0.19
    },
    {
      "speaker_id": "speaker_2",
      "speaker_name": "Speaker 2",
      "gender": "male",
      "language": "fr",
      "vocal_style": "normal",
      "start_time_s": 48.27,
      "end_time_s": 53.63,
      "duration_s": 5.36,
      "text": "Il nous rappelle que chaque instant est unique, surtout ici, près de l'équateur de nos vies.",
      "speaker_position": [
        2.84,
        5.05,
        1.27
      ],
      "speaker_size": 0.17
    },
    {
      "speaker_id": "speaker_1",
      "speaker_name": "Speaker 1",
      "gender": "female",
      "language": "fr",
      "vocal_style": "normal",
      "start_time_s": 53.86,
      "end_time_s": 57.94,
      "duration_s": 4.08,
      "text": "L'équateur de nos vies... Entre l'hémisphère passé et l'hémisphère futur.",
      "speaker_position": [
        3.01,
        2.77,
        1.78
      ],
      "speaker_size": 0.19
    },
    {
      "speaker_id": "speaker_2",
      "speaker_name": "Speaker 2",
      "gender": "male",
      "language": "fr",
      "vocal_style": "normal",
      "start_time_s": 58.22,
      "end_time_s": 63.29,
      "duration_s": 5.07,
      "text": "Juste. Et là, au milieu, il n'y a que le présent. Le silence.",
      "speaker_position": [
        2.84,
        5.05,
        1.27
      ],
      "speaker_size": 0.17
    },
    {
      "speaker_id": "speaker_1",
      "speaker_name": "Speaker 1",
      "gender": "female",
      "language": "fr",
      "vocal_style": "normal",
      "start_time_s": 63.6,
      "end_time_s": 65.85,
      "duration_s": 2.25,
      "text": "Le silence est notre meilleur ami ce soir.",
      "speaker_position": [
        3.01,
        2.77,
        1.78
      ],
      "speaker_size": 0.19
    },
    {
      "speaker_id": "speaker_2",
      "speaker_name": "Speaker 2",
      "gender": "male",
      "language": "fr",
      "vocal_style": "normal",
      "start_time_s": 66.03,
      "end_time_s": 68.73,
      "duration_s": 2.7,
      "text": "Je préfère dire notre plus vieux complice.",
      "speaker_position": [
        2.84,
        5.05,
        1.27
      ],
      "speaker_size": 0.17
    },
    {
      "speaker_id": "speaker_1",
      "speaker_name": "Speaker 1",
      "gender": "female",
      "language": "fr",
      "vocal_style": "normal",
      "start_time_s": 69.11,
      "end_time_s": 71.18,
      "duration_s": 2.07,
      "text": "Complice du néant ou de l'éternité ?",
      "speaker_position": [
        3.01,
        2.77,
        1.78
      ],
      "speaker_size": 0.19
    },
    {
      "speaker_id": "speaker_2",
      "speaker_name": "Speaker 2",
      "gender": "male",
      "language": "fr",
      "vocal_style": "normal",
      "start_time_s": 71.48,
      "end_time_s": 75.17,
      "duration_s": 3.69,
      "text": "Peut-être les deux. Ferme les yeux un instant. Écoute.",
      "speaker_position": [
        2.84,
        5.05,
        1.27
      ],
      "speaker_size": 0.17
    },
    {
      "speaker_id": "speaker_1",
      "speaker_name": "Speaker 1",
      "gender": "female",
      "language": "fr",
      "vocal_style": "normal",
      "start_time_s": 75.6,
      "end_time_s": 80.09,
      "duration_s": 4.49,
      "text": "J'écoute. Et pour la première fois, j'ai l'impression d'entendre quelque chose.",
      "speaker_position": [
        3.01,
        2.77,
        1.78
      ],
      "speaker_size": 0.19
