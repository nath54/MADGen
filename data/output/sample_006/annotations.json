      "language": "fr",
      "vocal_style": "interruption",
      "start_time_s": 181.16,
      "end_time_s": 186.0,
      "duration_s": 4.84,
      "text": "Le client appréciera aussi qu'on ne soit pas une simple consultary qui livre et part.",
