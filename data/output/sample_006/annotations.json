      "gender": "male",
      "language": "fr",
      "vocal_style": "normal",
      "start_time_s": 156.21,
      "end_time_s": 181.75,
      "duration_s": 25.54,
      "text": "J'ai noté ça dans le document de spécification. C'est bien plus flexible qu'une approche monolithique.",
