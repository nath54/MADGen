        7.14,
        5.21,
        1.71
      ],
      "speaker_size": 0.0
    },
    {
      "speaker_id": "speaker_6",
      "speaker_name": "Speaker 6",
      "gender": "male",
      "language": "fr",
      "vocal_style": "normal",
      "start_time_s": 81.08,
      "end_time_s": 84.76,
      "duration_s": 3.68,
      "text": "Donc, on retire leur intervention du prochain sprint ?",
      "speaker_position": [
        2.79,
        1.3,
        1.12
      ],
      "speaker_size": 0.4
    },
    {
      "speaker_id": "speaker_1",
      "speaker_name": "Speaker 1",
      "gender": "female",
      "language": "fr",
      "vocal_style": "normal",
      "start_time_s": 84.94,
      "end_time_s": 89.45,
      "duration_s": 4.51,
      "text": "Oui, et on utilise cette économie pour embaucher un développeur supplémentaire en interne.",
