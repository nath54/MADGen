        4.42,
        3.64,
        1.78
      ],
      "speaker_size": 0.17
    },
    {
      "speaker_id": "speaker_4",
      "speaker_name": "Speaker 4",
      "gender": "male",
      "language": "fr",
      "vocal_style": "normal",
      "start_time_s": 89.82,
      "end_time_s": 105.79,
      "duration_s": 15.97,
      "text": "Ça marche. Je vais ajuster les coûts dans le tableau de bord financier.",
