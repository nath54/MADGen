      "language": "fr",
      "vocal_style": "normal",
      "start_time_s": 106.39,
      "end_time_s": 111.14,
      "duration_s": 4.75,
      "text": "Parfait. Je m'occupe de réorganiser les tâches techniques pour compenser.",
      "speaker_position": [
        2.96,
        8.29,
        1.23
      ],
      "speaker_size": 0.0
    },
    {
      "speaker_id": "speaker_3",
