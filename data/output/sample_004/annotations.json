      "gender": "female",
      "language": "fr",
      "vocal_style": "normal",
      "start_time_s": 100.31,
      "end_time_s": 106.2,
      "duration_s": 5.89,
      "text": "Oui, nous avons appliqué un modèle de régression linéaire multiple pour isoler l'impact de la vitesse du vent.",
