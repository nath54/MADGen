        2.29,
        1.67
      ],
      "speaker_size": 0.0
    },
    {
      "speaker_id": "speaker_1",
      "speaker_name": "Speaker 1",
      "gender": "female",
      "language": "fr",
      "vocal_style": "normal",
      "start_time_s": 115.11,
      "end_time_s": 119.85,
      "duration_s": 4.74,
      "text": "Intéressant. Avez-vous vérifié la robustesse de ces résultats à travers un audit des données brutes ?",
