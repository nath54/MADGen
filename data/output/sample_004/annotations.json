        2.01,
        6.18,
        1.19
      ],
      "speaker_size": 0.24
    },
    {
      "speaker_id": "speaker_3",
      "speaker_name": "Speaker 3",
      "gender": "female",
      "language": "fr",
      "vocal_style": "normal",
      "start_time_s": 120.04,
      "end_time_s": 126.18,
      "duration_s": 6.14,
      "text": "Absolument. L'audit a révélé trois anomalies mineures dans les logs de capture, que nous avons interpolées.",
