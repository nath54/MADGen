      "speaker_name": "Speaker 2",
      "gender": "male",
      "language": "fr",
      "vocal_style": "normal",
      "start_time_s": 126.7,
      "end_time_s": 133.07,
      "duration_s": 6.37,
      "text": "La diaphote entre les deux capteurs a également été calibrée pour éviter les biais de luminosité.",
