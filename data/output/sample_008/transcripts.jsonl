{"speaker_id": "speaker_2", "speaker_name": "Speaker 2", "gender": "male", "language": "en", "vocal_style": "normal", "start_time_s": 105.32, "end_time_s": 110.77, "duration_s": 5.45, "text": "Cheers! May our stress levels drop and our fun levels skyrocket!", "speaker_position": [1.64, 5.96, 1.73], "speaker_size": 0.37}
